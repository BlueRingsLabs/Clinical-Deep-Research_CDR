# CDR environment
#   cp .env.example .env
#
# The only hard requirement is ONE working LLM provider key.
# Everything else has a sane default.

# =============================================================================
# LLM PROVIDERS — set at least one
# =============================================================================
# CDR tries LLM_DEFAULT_PROVIDER first, then falls back through whatever else
# is configured. Free tiers change often (and run out). If one dies, try another.

# gemini | groq | cerebras | openrouter | cloudflare | huggingface | openai | anthropic
LLM_DEFAULT_PROVIDER=gemini

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras — https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Cloudflare Workers AI — needs both values
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=

# Hugging Face Inference — https://huggingface.co/settings/tokens
# HF_TOKEN=
# Optional: your own Inference Endpoint / TGI server
# HF_ENDPOINT_URL=

# OpenAI (paid)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic (paid)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# =============================================================================
# LITERATURE SOURCES
# =============================================================================

# NCBI asks for a contact email on E-utilities requests. Use a real one.
NCBI_EMAIL=you@example.com

# Optional. Raises PubMed rate limits from 3 to 10 req/s.
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# =============================================================================
# STORAGE
# =============================================================================

CDR_DB_PATH=./data/cdr.db
CDR_ARTIFACT_PATH=./data/artifacts

# =============================================================================
# RETRIEVAL MODELS (downloaded on first use)
# =============================================================================

EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional vector store. Not needed for a normal run.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=cdr_embeddings

# =============================================================================
# BEHAVIOR
# =============================================================================

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

CDR_MAX_RECORDS_PER_SOURCE=100
CDR_CITATION_COVERAGE_THRESHOLD=0.90
CDR_STRICT_MODE=true
# Human-in-the-loop checkpoints (not implemented yet)
CDR_ENABLE_HITL=false
CDR_DEBUG=false
